# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase project URL and publishable (anon) key — from your Supabase
# project's API settings. Safe to expose to the browser (RLS enforces
# access control server-side). The secret/service-role key is
# intentionally not used anywhere in this app.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# Verified sender address. The Resend sandbox sender only delivers to your
# own Resend account email until a custom domain is verified — see
# https://resend.com/domains
RESEND_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Where contact/quote requests are delivered.
CONTACT_TO_EMAIL=anmolthakur2820@gmail.com

# The site's real, canonical production URL (no trailing slash) — used
# for metadataBase, Open Graph/Twitter absolute image URLs, canonical
# links, the sitemap, and robots.txt's Sitemap: line. Required in
# production; falls back to http://localhost:3000 in local dev if unset.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com
